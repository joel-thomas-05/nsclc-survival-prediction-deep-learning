    },
    {
      "cell_type": "code",
      "source": [
        "STANFORD_SLICE_DIR = \"/content/drive/MyDrive/Colab Notebooks/Stanford-Slices\"\n",
        "LUNG3_SLICE_DIR = \"/content/drive/MyDrive/Colab Notebooks/LUNG3-Slices\"\n",
        "\n",
        "STANFORD_LABEL_FILE = \"/content/drive/MyDrive/survivaldata.csv\"\n",
        "LUNG3_LABEL_FILE = \"/content/drive/MyDrive/Colab Notebooks/Clinical.Data.Lung3.xlsx\"\n",
        "\n",
