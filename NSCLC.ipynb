    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 3: Clean Patient Identifiers\n",
        "\n",
        "The CT slice files and clinical label files may store patient IDs with extra file extensions or suffixes. This helper function standardizes patient IDs before matching images to labels.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "pHU-Kj6YZNfJ"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def clean_patient_id(x):\n",
        "    x = str(x).strip()\n",
        "    x = x.replace(\".nii.gz\", \"\").replace(\".npz\", \"\")\n",
        "    x = x.replace(\"_selected_slices\", \"\")\n",
        "    return x"
      ],
      "metadata": {
        "id": "METSYnH5XZgp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 4: Load Survival Labels\n",
        "\n",
        "This cell loads binary survival labels for both cohorts.\n",
        "\n",
        "For Stanford, patient IDs are taken from `Case ID`, and labels are taken from `Survival Status`.\n",
        "\n",
        "For LUNG3, patient IDs are taken from `Unnamed: 0`, and labels are taken from `surv.clinical.Event`.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "nEPaoYAaZQfI"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def load_stanford_label_map(label_file):\n",
        "    df = pd.read_csv(label_file)\n",
        "\n",
        "    id_col = \"Case ID\"\n",
        "    label_col = \"Survival Status\"\n",
        "\n",
        "    if id_col not in df.columns:\n",
        "        raise ValueError(f\"Missing column: {id_col}\")\n",
        "    if label_col not in df.columns:\n",
        "        raise ValueError(f\"Missing column: {label_col}\")\n",
        "\n",
        "    label_map = {}\n",
        "\n",
        "    for _, row in df.iterrows():\n",
        "        patient_id = clean_patient_id(row[id_col])\n",
        "        value = row[label_col]\n",
        "\n",
        "        if pd.isna(value):\n",
        "            continue\n",
        "\n",
        "        value_str = str(value).strip().lower()\n",
        "\n",
        "        if value_str in [\"alive\", \"living\", \"1\", \"yes\", \"true\"]:\n",
        "            label = 1\n",
        "        elif value_str in [\"dead\", \"deceased\", \"died\", \"0\", \"no\", \"false\"]:\n",
        "            label = 0\n",
        "        else:\n",
        "            try:\n",
        "                numeric_value = float(value)\n",
        "                if numeric_value in [0, 1]:\n",
        "                    label = int(numeric_value)\n",
        "                else:\n",
        "                    continue\n",
        "            except Exception:\n",
        "                continue\n",
        "\n",
        "        label_map[patient_id] = label\n",
        "\n",
        "    print(\"Stanford usable labels:\", len(label_map))\n",
        "    print(\"Stanford label counts:\")\n",
        "    print(pd.Series(list(label_map.values())).value_counts().sort_index())\n",
        "\n",
        "    return label_map"
      ],
      "metadata": {
        "id": "9ztu5KAVXbYD"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 5: Crop CT Slices Around the Tumor Mask\n",
        "\n",
        "This function crops each CT slice around the tumor segmentation mask. The margin keeps a small amount of surrounding tissue around the tumor region.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "X_DZ7_6SZRlf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def crop_to_mask_with_margin(img_slice, seg_slice, margin=10):\n",
        "    ys, xs = np.where(seg_slice > 0)\n",
        "\n",
        "    if len(xs) == 0 or len(ys) == 0:\n",
        "        return img_slice, seg_slice\n",
        "\n",
        "    x0 = max(0, xs.min() - margin)\n",
        "    x1 = min(img_slice.shape[1], xs.max() + margin + 1)\n",
        "    y0 = max(0, ys.min() - margin)\n",
        "    y1 = min(img_slice.shape[0], ys.max() + margin + 1)\n",
        "\n",
        "    return img_slice[y0:y1, x0:x1], seg_slice[y0:y1, x0:x1]"
      ],
      "metadata": {
        "id": "I1vvKOUNXdfL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 6: Normalize and Preprocess CT Slices\n",
        "\n",
        "This cell applies tumor-based normalization. When a tumor mask is available, intensity values are normalized using the tumor region. If the mask is empty, the full CT slice is used as a fallback.\n",
        "\n",
        "Each slice is resized to 224 × 224, converted to three channels, and preprocessed for ResNet50.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "mXVOWuW5ZUxO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def preprocess_saved_slice_tumor_norm(img_slice, seg_slice, use_bbox_crop=True, bbox_margin=10):\n",
        "    image = img_slice.astype(np.float32)\n",
        "    mask = (seg_slice > 0).astype(np.float32)\n",
        "\n",
        "    if use_bbox_crop and np.any(mask > 0):\n",
        "        image, mask = crop_to_mask_with_margin(image, mask, margin=bbox_margin)\n",
        "        mask = (mask > 0).astype(np.float32)\n",
        "\n",
        "    if np.any(mask > 0):\n",
        "        tumor_values = image[mask > 0]\n",
        "        min_value = tumor_values.min()\n",
        "        max_value = tumor_values.max()\n",
        "        image_norm = (image - min_value) / (max_value - min_value + 1e-5)\n",
        "    else:\n",
        "        min_value = image.min()\n",
        "        max_value = image.max()\n",
        "        image_norm = (image - min_value) / (max_value - min_value + 1e-5)\n",
        "\n",
        "    image_norm = np.clip(image_norm, 0.0, 1.0)\n",
        "\n",
        "    image_tensor = tf.convert_to_tensor(image_norm[..., np.newaxis], dtype=tf.float32)\n",
        "    image_tensor = tf.image.resize(image_tensor, [IMG_SIZE, IMG_SIZE])\n",
        "    image_tensor = tf.repeat(image_tensor, repeats=3, axis=-1)\n",
        "\n",
        "    image_tensor = image_tensor * 255.0\n",
        "    image_tensor = preprocess_input(image_tensor)\n",
        "\n",
        "    return image_tensor.numpy()"
      ],
      "metadata": {
        "id": "maIecAAfXcrF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 7: Extract ResNet50 Features\n",
        "\n",
        "ResNet50 is used as a pretrained feature extractor. The final classification layer is removed, so each CT slice is converted into a 2048-dimensional feature vector.\n",
        "\n",
        "The extracted features are later reduced using PR-Isomap before survival prediction.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "ElYPZleyZX7H"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "resnet = ResNet50(\n",
        "    weights=\"imagenet\",\n",
        "    include_top=False,\n",
        "    pooling=\"avg\",\n",
        "    input_shape=(IMG_SIZE, IMG_SIZE, 3)\n",
        ")\n",
        "\n",
        "\n",
        "def flush_batch_and_extract(batch_imgs, batch_meta, feature_list, label_list, patient_list):\n",
        "    if len(batch_imgs) == 0:\n",
        "        return\n",
        "\n",
        "    batch_array = np.stack(batch_imgs, axis=0).astype(np.float32)\n",
        "    batch_features = resnet.predict(batch_array, batch_size=BATCH_SIZE, verbose=0)\n",
        "\n",
        "    for feature, meta in zip(batch_features, batch_meta):\n",
        "        feature_list.append(feature)\n",
        "        label_list.append(meta[\"label\"])\n",
        "        patient_list.append(meta[\"patient_id\"])\n",
        "\n",
        "\n",
        "def extract_features_from_saved_dir(slice_dir, label_map, dataset_name):\n",
        "    npz_files = sorted([f for f in os.listdir(slice_dir) if f.endswith(\".npz\")])\n",
        "\n",
        "    features = []\n",
        "    labels = []\n",
        "    patient_ids = []\n",
        "\n",
        "    batch_imgs = []\n",
        "    batch_meta = []\n",
        "\n",
        "    used_patients = 0\n",
        "    skipped_patients = 0\n",
        "    total_slices = 0\n",
        "\n",
        "    for file_name in npz_files:\n",
        "        file_path = os.path.join(slice_dir, file_name)\n",
        "        data = np.load(file_path, allow_pickle=True)\n",
        "\n",
        "        patient_id_raw = data[\"patient_id\"]\n",
        "        patient_id = clean_patient_id(\n",
        "            patient_id_raw.item() if hasattr(patient_id_raw, \"item\") else patient_id_raw\n",
        "        )\n",
        "\n",
        "        if patient_id not in label_map:\n",
        "            skipped_patients += 1\n",
        "            continue\n",
        "\n",
        "        label = int(label_map[patient_id])\n",
        "\n",
        "        image_slices = data[\"image_slices\"]\n",
        "        segmentation_slices = data[\"seg_slices\"]\n",
        "\n",
        "        used_patients += 1\n",
        "\n",
        "        for image_slice, segmentation_slice in zip(image_slices, segmentation_slices):\n",
        "            processed_image = preprocess_saved_slice_tumor_norm(\n",
        "                image_slice,\n",
        "                segmentation_slice,\n",
        "                use_bbox_crop=USE_BBOX_CROP,\n",
        "                bbox_margin=BBOX_MARGIN\n",
        "            )\n",
        "\n",
        "            batch_imgs.append(processed_image)\n",
        "            batch_meta.append({\n",
        "                \"label\": label,\n",
        "                \"patient_id\": patient_id\n",
        "            })\n",
        "\n",
        "            total_slices += 1\n",
        "\n",
        "            if len(batch_imgs) >= BATCH_SIZE:\n",
        "                flush_batch_and_extract(\n",
        "                    batch_imgs,\n",
        "                    batch_meta,\n",
        "                    features,\n",
        "                    labels,\n",
        "                    patient_ids\n",
        "                )\n",
        "\n",
        "                batch_imgs = []\n",
        "                batch_meta = []\n",
        "\n",
        "    flush_batch_and_extract(\n",
        "        batch_imgs,\n",
        "        batch_meta,\n",
        "        features,\n",
        "        labels,\n",
        "        patient_ids\n",
        "    )\n",
        "\n",
        "    X = np.array(features, dtype=np.float32)\n",
        "    y = np.array(labels, dtype=np.int32)\n",
        "    patient_ids = np.array(patient_ids)\n",
        "\n",
        "    print(f\"\\n{dataset_name} feature extraction complete\")\n",
        "    print(\"Used patients:\", used_patients)\n",
        "    print(\"Skipped patients without labels:\", skipped_patients)\n",
        "    print(\"Total slices used:\", total_slices)\n",
        "    print(\"Feature matrix shape:\", X.shape)\n",
        "\n",
        "    return X, y, patient_ids"
      ],
      "metadata": {
        "id": "GUh1H8ToXdZP"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 8: Load Labels and Build Feature Tables\n",
        "\n",
        "This cell loads the survival labels and extracts ResNet50 features for both datasets.\n",
        "\n",
        "Stanford is used for model development, while LUNG3 is held out for external validation.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "9_Shx-Lmaeih"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "stanford_label_map = load_stanford_label_map(STANFORD_LABEL_FILE)\n",
        "lung3_label_map = load_lung3_label_map(LUNG3_LABEL_FILE)\n",
        "\n",
        "X_stanford, y_stanford, pid_stanford = extract_features_from_saved_dir(\n",
        "    STANFORD_SLICE_DIR,\n",
        "    stanford_label_map,\n",
        "    \"Stanford\"\n",
        ")\n",
        "\n",
        "X_lung3, y_lung3, pid_lung3 = extract_features_from_saved_dir(\n",
        "    LUNG3_SLICE_DIR,\n",
        "    lung3_label_map,\n",
        "    \"LUNG3\"\n",
        ")\n",
        "\n",
        "print(\"\\nStanford slice label counts:\")\n",
        "print(pd.Series(y_stanford).value_counts().sort_index())\n",
        "\n",
        "print(\"\\nLUNG3 slice label counts:\")\n",
        "print(pd.Series(y_lung3).value_counts().sort_index())"
      ],
      "metadata": {
        "id": "4vqtJmOVXzwY"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 9: Create a Patient-Aware Stanford Split\n",
        "\n",
        "This split keeps all slices from the same patient together. This avoids slice leakage, where the model could train on one slice from a patient and validate on another slice from the same patient.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "CxR4wMi5arvw"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "splitter = GroupShuffleSplit(\n",
        "    n_splits=1,\n",
        "    test_size=0.2,\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "\n",
        "train_idx, val_idx = next(\n",
        "    splitter.split(X_stanford, y_stanford, groups=pid_stanford)\n",
        ")\n",
        "\n",
        "X_train_raw = X_stanford[train_idx]\n",
        "X_val_raw = X_stanford[val_idx]\n",
        "\n",
        "y_train = y_stanford[train_idx]\n",
        "y_val = y_stanford[val_idx]\n",
        "\n",
        "pid_train = pid_stanford[train_idx]\n",
        "pid_val = pid_stanford[val_idx]\n",
        "\n",
        "print(\"Training slices:\", X_train_raw.shape[0])\n",
        "print(\"Validation slices:\", X_val_raw.shape[0])\n",
        "print(\"Training patients:\", len(np.unique(pid_train)))\n",
        "print(\"Validation patients:\", len(np.unique(pid_val)))"
      ],
      "metadata": {
        "id": "2ItQChUMatRN"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 10: Define the Survival Prediction Model\n",
        "\n",
        "This neural network receives PR-Isomap features and predicts binary survival status.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "WxZwAqnjawQ_"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def build_nn_classifier(input_dim, learning_rate=1e-4):\n",
        "    model = tf.keras.Sequential([\n",
        "        layers.Input(shape=(input_dim,)),\n",
        "        layers.Dense(128, activation=\"relu\"),\n",
        "        layers.Dropout(0.3),\n",
        "        layers.Dense(64, activation=\"relu\"),\n",
        "        layers.Dropout(0.2),\n",
        "        layers.Dense(1, activation=\"sigmoid\")\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=learning_rate),\n",
        "        loss=\"binary_crossentropy\",\n",
        "        metrics=[\n",
        "            \"accuracy\",\n",
        "            tf.keras.metrics.AUC(name=\"auc\")\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    return model"
      ],
      "metadata": {
        "id": "CPslnW3IaxE8"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# %% [markdown]\n",
        "\"\"\"\n",
        "## Cell 11: Search PR-Isomap Settings\n",
        "\n",
        "This cell searches different PR-Isomap neighborhood and component settings.\n",
        "\n",
        "For each setting, the Stanford training set is scaled, reduced with PR-Isomap, and used to train a neural network. The best setting is selected using Stanford validation ROC-AUC.\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "F_ap15-ia5jp"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# %%\n",
        "search_results = []\n",
        "\n",
        "scaler_search = StandardScaler()\n",
        "X_train_scaled = scaler_search.fit_transform(X_train_raw)\n",
        "X_val_scaled = scaler_search.transform(X_val_raw)\n",
        "\n",
        "classes = np.unique(y_train)\n",
        "\n",
        "weights = compute_class_weight(\n",
        "    class_weight=\"balanced\",\n",
        "    classes=classes,\n",
        "    y=y_train\n",
        ")\n",
        "\n",
        "class_weight = {\n",
        "    int(class_id): float(weight)\n",
        "    for class_id, weight in zip(classes, weights)\n",
        "}\n",
        "\n",
        "for n_neighbors in N_NEIGHBORS_OPTIONS:\n",
        "    for n_components in N_COMPONENTS_OPTIONS:\n",
        "        print(f\"Testing n_neighbors={n_neighbors}, n_components={n_components}\")\n",
        "\n",
        "        embedder = Isomap(\n",
        "            n_neighbors=n_neighbors,\n",
        "            n_components=n_components\n",
        "        )\n",
        "\n",
        "        X_train_emb = embedder.fit_transform(X_train_scaled)\n",
        "        X_val_emb = embedder.transform(X_val_scaled)\n",
        "\n",
        "        model = build_nn_classifier(\n",
        "            input_dim=n_components,\n",
        "            learning_rate=1e-4\n",
        "        )\n",
        "\n",
        "        early_stop = callbacks.EarlyStopping(\n",
        "            monitor=\"val_auc\",\n",
        "            mode=\"max\",\n",
        "            patience=10,\n",
        "            restore_best_weights=True,\n",
        "            verbose=0\n",
        "        )\n",
        "\n",
        "        model.fit(\n",
