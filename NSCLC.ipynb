    {
      "cell_type": "code",
      "source": [
        "def aggregate_to_patient_level(patient_ids, y_true, y_prob, threshold=0.5):\n",
        "    df = pd.DataFrame({\n",
        "        \"patient_id\": patient_ids,\n",
        "        \"y_true\": y_true,\n",
        "        \"y_prob\": y_prob\n",
        "    })\n",
        "\n",
        "    patient_df = df.groupby(\"patient_id\").agg({\n",
        "        \"y_true\": \"first\",\n",
        "        \"y_prob\": \"mean\"\n",
        "    }).reset_index()\n",
        "\n",
        "    patient_df[\"y_pred\"] = (patient_df[\"y_prob\"] >= threshold).astype(int)\n",
        "\n",
        "    return patient_df\n",
        "\n",
        "\n",
        "lung3_patient_df = aggregate_to_patient_level(\n",
        "    pid_lung3,\n",
        "    y_lung3,\n",
        "    lung3_prob,\n",
        "    threshold=best_thresh\n",
        ")\n",
        "\n",
        "print(\"LUNG3 Patient-Level Results\")\n",
        "print(\"Patients:\", len(lung3_patient_df))\n",
        "print(\"Accuracy:\", accuracy_score(lung3_patient_df[\"y_true\"], lung3_patient_df[\"y_pred\"]))\n",
        "print(\"Balanced Accuracy:\", balanced_accuracy_score(lung3_patient_df[\"y_true\"], lung3_patient_df[\"y_pred\"]))\n",
        "print(\"ROC-AUC:\", roc_auc_score(lung3_patient_df[\"y_true\"], lung3_patient_df[\"y_prob\"]))\n",
        "\n",
        "print(\"\\nConfusion Matrix:\")\n",
        "print(confusion_matrix(lung3_patient_df[\"y_true\"], lung3_patient_df[\"y_pred\"]))\n",
        "\n",
        "print(\"\\nClassification Report:\")\n",
